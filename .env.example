# 后端环境变量（复制为 .env 使用；.env 进 .gitignore，禁止提交密钥）
# 变量说明见《开发技术文档》§2.4
APP_ENV=development
APP_PORT=8000
# BASE_DIR=                 # 项目根目录，默认由 config.py 自动推导，无需设置

# ---------- 路径（相对 BASE_DIR，禁止硬编码绝对路径） ----------
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
MODEL_DIR=outputs/models

# ---------- 模型 ----------
ACTIVE_MODEL=lstm_v1

# ---------- 认证（🔒 BE-05：生产环境必须改为随机长串 ≥32 字符） ----------
JWT_SECRET=please-change-me-to-a-random-32-char-secret
JWT_EXPIRE_MINUTES=720
LOGIN_MAX_FAIL=3
LOGIN_LOCK_SECONDS=60

# ---------- 业务上限 ----------
MAX_FILE_SIZE_MB=20
MAX_ROWS=500000
MAX_SERIES=1000
TASK_BUDGET_MS=60000
EXPORT_TTL_DAYS=7

# ---------- 其他 ----------
CORS_ORIGINS=http://localhost:5173
TORCH_DEVICE=auto

# ---------- 对外发布（见《对外发布与多用户访问方案 V1.0》§6.1）----------
# 🔒 ALLOW_GUEST=false ⇒ 关闭「免登录试跑」，上传/参数/执行/结果整条链路要求登录。
#    公开部署**应置 false**：游客哨兵 user_id=0 是所有未登录请求共用的桶，
#    归属判定会退化成「0 == 0 恒真」⇒ 任何人可读他人上传的数据。
#    保持 true 时行为与 PRD `FR-USR-08` 一致（开发与课程交付用默认值）。
ALLOW_GUEST=true
# 单端口形态：由 FastAPI 直接托管前端产物（无 Nginx / 平台托管时用）
SERVE_FRONTEND=false
FRONTEND_DIR=web/dist
