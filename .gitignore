# ===== 环境变量（含密钥，禁止提交） =====
.env

# ===== 运行期数据（工作区内，不入库） =====
data/

# ===== 前端依赖与构建产物 =====
web/node_modules/
web/dist/
web/.vite/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ===== 编辑器 / 系统 =====
.DS_Store
Thumbs.db
.idea/
.vscode/

# ===== 临时文件 =====
*.log
*.tmp

# ===== 工作区内部记忆（AI 协作过程的笔记，不属交付物） =====
.workbuddy/

# ===== 测试证据截图与大体量测试样例（走查留痕，不入库） =====
# 命中 outputs/ep2-shots/ ... ep10-shots/ 与 outputs/prototype-shots/
# 注：outputs/ 根目录的正式交付物（PDF / Word / PPT / 接口文档 / 模型）
#     与 outputs/models/、outputs/电商销量预测系统_答辩演示_V1.0/ 不受影响
outputs/*-shots/

# ===== 代码审查留痕（探针原始 JSON + 截图，不入库） =====
# 与上一条同源约定：证据截图与机器生成的原始数据不属交付物；
# 审查报告正文（outputs/前端代码审查报告_V1.0.md）与探针脚本（scripts/_*.mjs）仍入库。
outputs/review-probe/

# ===== 对外发布的部署暂存目录（含生产密钥与产物，不入库） =====
deploy/

# ===== 平台发布元数据（含 localDir 绝对路径与 appId，纯本机产物，不入库） =====
.wbapp_*.genie
